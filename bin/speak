#!/usr/bin/env python3
"""Optional LISA text-to-speech wrapper.

Set LISA_SPEAK_BIN=/path/to/speak to route messages through a local TTS
command. If unset or missing, the script safely falls back to stdout.
"""

import os
import subprocess
import sys
from pathlib import Path


def main() -> int:
    if len(sys.argv) < 2:
        print("Usage: speak 'message'")
        return 1

    message = "LISA: " + " ".join(sys.argv[1:])
    external_speak = Path(os.environ.get("LISA_SPEAK_BIN", "/home/bc/bin/speak"))

    if external_speak.exists() and os.access(external_speak, os.X_OK):
        subprocess.run([str(external_speak), message], check=False)
    else:
        print(f"[SPEAK] {message}")

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
